{
  "name": "fuxiaowai-android",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "福小外课表 · Android 版（Web 重写 + Capacitor）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "apk": "cd android && gradlew.bat assembleDebug",
    "test": "node --test tests/*.test.cjs",
    "check": "npm test && npm run check:ui && npm run build",
    "check:ui": "node tools/check-ui-contract.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
