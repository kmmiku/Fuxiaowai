# Include in your existing HTTPS server block with real certificate.
# Redirect HTTP to HTTPS separately; Basic Auth requires HTTPS.
client_max_body_size 4m;
client_body_timeout 15s;
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite, never append user-supplied forwarding headers.
    proxy_set_header X-FXW-Client-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Connection "";
    proxy_read_timeout 35s;
    proxy_send_timeout 35s;
}
