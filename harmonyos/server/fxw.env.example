# Copy to /etc/fxw-share.env (0600), replace credentials before starting.
FXW_ADMIN_USER=CHANGE_ME
FXW_ADMIN_PASS=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
FXW_BIND=127.0.0.1
FXW_PORT=8080
FXW_ROOT=/var/lib/fxw
FXW_TRUST_PROXY=1
FXW_MAX_TICKETS=100000
FXW_MAX_FEEDBACK=20000
FXW_MIN_FREE_BYTES=536870912
FXW_FEEDBACK_PER_MIN=20
FXW_MAX_ACTIVE_WRITES=8
NODE_ENV=production
